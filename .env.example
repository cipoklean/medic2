# Nebius Token Factory (required for headline runs)
NEBIUS_API_KEY=
# Tavily (required for conditions C and D)
TAVILY_API_KEY=
# Optional, dev only: OpenRouter free Nemotron so you don't burn credits while building.
# Headline benchmark numbers must come from Token Factory (MEDIC_PROVIDER=nebius).
OPENROUTER_API_KEY=
MEDIC_PROVIDER=nebius
